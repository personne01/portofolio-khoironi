# Copy to .env and adjust for your machine. Never commit real credentials.

# Connection string used by the app at runtime (lib/db.ts). Required.
#
# Local development -- a plain local PostgreSQL:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"
#
# On Supabase, use the transaction-mode pooler (port 6543) with
# ?sslmode=require. A direct connection here would make every serverless
# instance open its own pool and exhaust max_connections. Swap the line above
# for the commented shape below:
#   DATABASE_URL="postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Do not add ?pgbouncer=true -- this app uses @prisma/adapter-pg, not Prisma's
# pooled engine.

# Unpooled connection used by the Prisma CLI for migrations and introspection
# only (see prisma7.config.ts). A transaction-mode pooler cannot run DDL, so
# this must be a direct connection. Optional: when unset, the CLI falls back to
# DATABASE_URL, which is fine locally.
#
# prisma7.config.ts resolves the CLI datasource as DIRECT_URL ?? DATABASE_URL.
# Because of that, setting this makes the CLI IGNORE an inline DATABASE_URL, so
# always pass DIRECT_URL when targeting another database for migrations.
#
# On Supabase the direct connection lives on a DIFFERENT host than the pooler --
# it is not the pooler host on a different port:
#   DIRECT_URL="postgresql://USER:PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"

# Must be exactly "1" to let `prisma/seed.ts` run. The seed DELETEs all rows in
# 14 content tables before re-inserting demo data, so it refuses by default.
# `prisma/seed-guard.ts` refuses regardless when NODE_ENV is "production" or the
# host above looks like a production database, even with this set to 1.
# Deliberately left unset here, so a fresh checkout cannot run the seed by
# accident. Pass it per-invocation instead:
#   ALLOW_DESTRUCTIVE_SEED=1 npx prisma db seed

# Reserved for future database-backed tests. No test currently reads this -- the
# Vitest suite is unit-level and stubs `server-only` (tests/stubs/), so it needs
# no live database. When DB-backed tests are added, point this at a throwaway
# database: it gets dropped and re-migrated, never a real one.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_test?schema=public"

# Absolute base URL of this Next.js app, used by server components to call the
# public API. Must be reachable from the server process (e.g. http://127.0.0.1:3000
# during `npm run dev`). No trailing slash.
API_BASE_URL="http://127.0.0.1:3000"

# Comma-separated list of origins allowed to call the public API.
# Leave empty to disable CORS headers entirely (same-origin only).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
